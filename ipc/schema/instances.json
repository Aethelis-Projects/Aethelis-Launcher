{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InstanceSchema",
  "type": "object",
  "definitions": {
    "Instance": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "game_version": { "type": "string" },
        "loader": { "type": "string", "enum": ["vanilla", "fabric", "quilt", "forge", "neoforge"] },
        "loader_version": { "type": "string" },
        "icon_path": { "type": "string" },
        "state": { "type": "string", "enum": ["idle", "downloading", "launching", "running", "crashed"] },
        "total_play_seconds": { "type": "integer" }
      },
      "required": ["id", "name", "game_version", "loader", "state"]
    },
    "CreateInstanceRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "game_version": { "type": "string" },
        "loader": { "type": "string" }
      },
      "required": ["name", "game_version", "loader"]
    },
    "LaunchResponse": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "pid": { "type": "integer" },
        "error": { "type": "string" }
      },
      "required": ["success"]
    }
  }
}
